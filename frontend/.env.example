# NetWatch AI — Frontend Environment Configuration Template
#
# Copy this file to `.env.development` (or `.env.local`) and adjust the base
# URLs for your local backend.
#
# IMPORTANT: every `VITE_*` variable is inlined into the client bundle and is
# therefore PUBLIC. Never put a backend secret, credential, token or DSN here.
# The frontend holds no secrets by design (M15.37).

# Base URL of the versioned REST API (M13). No trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Base URL of the real-time WebSocket channels (M14). No trailing slash and no
# channel name: `/ws/dashboard`, `/ws/packets`, `/ws/alerts` and `/ws/system`
# are appended by the client.
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# Milliseconds before a REST request is aborted as a timeout.
VITE_API_TIMEOUT_MS=15000
