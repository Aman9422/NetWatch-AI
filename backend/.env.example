# NetWatch AI — Backend Environment Configuration Template
#
# Copy this file to `backend/.env` and adjust values for your local environment.
# Never commit the real `.env` file to Git.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=NetWatch AI
APP_ENV=development

# ---------------------------------------------------------------------------
# Backend Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./netwatch.db

# ---------------------------------------------------------------------------
# Capture
# ---------------------------------------------------------------------------
# Optional: default network interface to select on startup, e.g. "Wi-Fi".
# If blank or invalid, the InterfaceManager leaves no interface selected.
DEFAULT_CAPTURE_INTERFACE=

# ---------------------------------------------------------------------------
# Packet Persistence (M7)
# ---------------------------------------------------------------------------
# Persist normalized packet metadata to SQLite. Set to false to disable it.
PACKET_PERSISTENCE_ENABLED=true
# Buffered packets that trigger a database write.
PACKET_BATCH_SIZE=500
# Seconds a non-empty buffer may wait before it is flushed anyway.
PACKET_FLUSH_INTERVAL_SECONDS=2.0
# Hard cap on buffered packets; the oldest are dropped (and logged) when full.
PACKET_QUEUE_MAX=10000
# Days a packet row is kept before retention cleanup may delete it.
# 0 keeps packets forever. This window is enforced automatically by the retention
# sweep below; before M19 nothing ever called the cleanup, so it was documented
# but never applied.
PACKET_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Report Storage and Retention (M17, retention added by M19)
# ---------------------------------------------------------------------------
# Directory generated report files are written to. A relative path is resolved
# against the process working directory. Excluded from version control.
REPORT_STORAGE_DIR=reports
# Most rows any one report table carries.
REPORT_MAX_TABLE_ROWS=100
# Days a generated report and its file are kept before retention may remove both.
# **0 keeps every report, and 0 is the default.** Report deletion is opt-in: set a
# positive number to have old reports removed automatically. The metadata row and
# the file are always removed together, so a listing can never claim a file that
# is gone.
REPORT_RETENTION_DAYS=0
# Most reports one cleanup pass removes; a larger backlog drains over several
# passes so a pass always holds a transaction for a bounded time.
REPORT_RETENTION_MAX_PER_RUN=500

# ---------------------------------------------------------------------------
# Retention Sweep (M19)
# ---------------------------------------------------------------------------
# Seconds between automatic retention passes, which is what makes the retention
# windows above actually take effect. 0 disables the sweep, leaving every window
# unenforced. The first pass runs one interval after startup, so starting the
# application never deletes anything by surprise.
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# Local LLM Integration (M23)
# ---------------------------------------------------------------------------
# Master switch for the local-model layer. **Off by default**: a local model costs
# several gigabytes of RAM, so enabling it is a deliberate act and never a side
# effect of upgrading. While false, nothing is contacted and no probe is made.
#
# This switch is NOT the `ai_enabled` row in the settings table. That is a
# different, older switch which this runtime does not read.
LLM_ENABLED=false
# The only implemented runtime. Any other value is refused at startup.
LLM_PROVIDER=ollama
# Where the runtime's HTTP API listens. Loopback by default, and not overridable
# per request: a client cannot point this application at an arbitrary host.
LLM_BASE_URL=http://127.0.0.1:11434
# The model an operator has installed and chosen. Blank while LLM_ENABLED=false;
# required once it is true. M23 never selects or downloads a model automatically.
# Install one yourself first, e.g.:  ollama pull llama3.2:3b
LLM_MODEL=
# Seconds a single generation may take. Sized against measured behaviour: ~9 s to
# load a 3B model into 4 GB of VRAM plus ~9 s to emit 512 tokens at ~56 tok/s.
LLM_TIMEOUT_SECONDS=60
# Seconds a *health probe* may take. Deliberately much shorter than the above,
# because an unreachable host hangs rather than refusing a connection. Must be
# shorter than LLM_TIMEOUT_SECONDS or startup fails.
LLM_HEALTH_TIMEOUT_SECONDS=3
# Most generations that may run at once. One is right for a 4 GB card; a second
# concurrent request is refused with a 409 rather than queued.
LLM_MAX_CONCURRENT_REQUESTS=1
# Hardest ceiling on a prompt, in characters. Cannot be configured above 8000.
LLM_MAX_PROMPT_CHARS=4000
# Hardest ceiling on a reply, in tokens. Cannot be configured above 2048, and must
# stay below LLM_NUM_CTX.
LLM_MAX_OUTPUT_TOKENS=512
# Context window requested from the runtime. Pinned rather than inherited: the
# reference model advertises a 131,072-token context, and a runtime left to size
# its KV cache from that will fail to load a 2 GB model on a 4 GB card.
LLM_NUM_CTX=4096
# How long the model stays resident after a request.
LLM_KEEP_ALIVE=5m

# ---------------------------------------------------------------------------
# Connection Tracking (M9)
# ---------------------------------------------------------------------------
# Master switch for the connection-tracking consumer of the capture pipeline.
# When false, packets are still captured, processed, stored and associated
# with devices; they are simply not grouped into conversations.
CONNECTION_TRACKING_ENABLED=true
# Seconds an idle TCP connection may wait before it is retired.
CONNECTION_TCP_TIMEOUT_SECONDS=300
# Seconds an idle UDP conversation may wait before it is retired.
CONNECTION_UDP_TIMEOUT_SECONDS=60
# Seconds an idle ICMP conversation may wait before it is retired.
CONNECTION_ICMP_TIMEOUT_SECONDS=30
# Hard cap on active connections; a flow flood cannot exhaust memory.
CONNECTION_MAX_TRACKED=8192
# Retired connections kept for reporting; the oldest are dropped past the cap.
CONNECTION_MAX_HISTORICAL=1024
# Period of the background idle sweep, in seconds.
CONNECTION_CLEANUP_INTERVAL_SECONDS=5
# Write aggregated conversations to the `connections` table (M9.17).
CONNECTION_PERSISTENCE_ENABLED=true
# Upper bound on connection rows written per persistence pass.
CONNECTION_PERSISTENCE_MAX_PER_PASS=500
