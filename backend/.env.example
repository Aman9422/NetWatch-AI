# NetWatch AI — Backend Environment Configuration Template
#
# Copy this file to `backend/.env` and adjust values for your local environment.
# Never commit the real `.env` file to Git.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=NetWatch AI
APP_ENV=development

# ---------------------------------------------------------------------------
# Backend Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./netwatch.db

# ---------------------------------------------------------------------------
# Capture
# ---------------------------------------------------------------------------
# Optional: default network interface to select on startup, e.g. "Wi-Fi".
# If blank or invalid, the InterfaceManager leaves no interface selected.
DEFAULT_CAPTURE_INTERFACE=

# ---------------------------------------------------------------------------
# Packet Persistence (M7)
# ---------------------------------------------------------------------------
# Persist normalized packet metadata to SQLite. Set to false to disable it.
PACKET_PERSISTENCE_ENABLED=true
# Buffered packets that trigger a database write.
PACKET_BATCH_SIZE=500
# Seconds a non-empty buffer may wait before it is flushed anyway.
PACKET_FLUSH_INTERVAL_SECONDS=2.0
# Hard cap on buffered packets; the oldest are dropped (and logged) when full.
PACKET_QUEUE_MAX=10000
# Days a packet row is kept before retention cleanup may delete it.
PACKET_RETENTION_DAYS=30
